# BusinessOS AI - Master Environment Variables Example

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL / Neon Multi-tenant Database Connection
DATABASE_URL="postgresql://businessos_owner:neon_secret_pass@ep-cool-lake-123456.us-east-2.aws.neon.tech/businessos_db?sslmode=require"

# Authentication & Session Security
JWT_SECRET="super-secret-businessos-jwt-key-change-in-production-min32chars"
NEXTAUTH_SECRET="super-secret-nextauth-session-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration (openai | anthropic | gemini | groq | mock)
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-simulated_openai_key_placeholder"
ANTHROPIC_API_KEY="sk-ant-simulated_claude_key_placeholder"
GEMINI_API_KEY="AIzaSy_simulated_gemini_key_placeholder"
GROQ_API_KEY="gsk_simulated_groq_key_placeholder"
GROQ_MODEL="openai/gpt-oss-120b"

# Razorpay Integration (Use Simulation/Mock Mode during development)
RAZORPAY_MODE="SIMULATION"
RAZORPAY_KEY_ID="rzp_test_simulated_key_123"
RAZORPAY_KEY_SECRET="rzp_test_simulated_secret_456"
RAZORPAY_WEBHOOK_SECRET="rzp_whsec_simulated_secret_789"

# API Base Endpoint
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
